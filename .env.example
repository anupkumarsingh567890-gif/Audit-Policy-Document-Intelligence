# Copy this file to .env and paste your key. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (free tier). Fallbacks are tried in order if the main model
# is unavailable or rate-limited. Run `python scripts/list_models.py` to see
# exactly which models your key can use.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
# Thinking before answering: off = fastest, low = fast + careful (default), default = model decides
GEMINI_THINKING=low

# Embeddings / chunking / retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
